# Copy this file to `.env` (gitignored) and fill in real values. The dev script
# (scripts/run-backend.mjs) loads it automatically for `pnpm run dev`.
#
# Used by the backend to send password-reset OTP emails. One Gmail app password
# can be reused across all projects — Google does not require a unique one per
# project. Create one at Google Account > Security > 2-Step Verification >
# App passwords (Gmail needs 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Prescription Scanner <>