# Copy to `.env.local` (gitignored) and adjust if needed.

# Where the Vite dev server proxies /api requests (the Spring Boot backend).
# Defaults to http://localhost:8080 when unset.
VITE_PROXY_TARGET=http://localhost:8080

# Only set this when NOT using the dev proxy, e.g. serving the built app from
# a different origin than the backend. Leave empty for same-origin / proxy.
# VITE_API_BASE=
